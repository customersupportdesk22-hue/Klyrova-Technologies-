# Required for the review service
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=klyrova
REVIEW_ADMIN_TOKEN=replace-with-a-long-random-secret
REVIEW_NOTIFICATION_EMAIL=bahzuri60@gmail.com

# Optional email notifications (Resend; verify your sender domain first)
RESEND_API_KEY=
RESEND_FROM=Klyrova Reviews <reviews@your-verified-domain.com>

# Separate long random secret for the private Klyrova Command Centre
COMMAND_CENTRE_ADMIN_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
